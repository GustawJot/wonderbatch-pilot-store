# Copy to .env and fill in. The real .env is gitignored — it holds a live token.

# The Wonderbatch API we call. Port 3000 for both `npm run dev` and
# `npm run preview`, so this value does not change when the API mode does.
# CORS assertions are only truthful against `preview` — `vite dev` injects
# permissive CORS headers of its own.
WB_API_BASE_URL=http://localhost:3000

# What this client claims to be. MUST be sent on every request: a caller that
# omits the Origin header skips the channel's allowlist entirely and gets a
# 200, so a suite that forgets it never exercises the check at all.
# Must exactly match an entry in the channel's `security.allowed_origins`
# (exact string comparison — a trailing slash never matches).
WB_PILOT_ORIGIN=http://localhost:5173

# Mint with, from web/:
#   node --experimental-strip-types --env-file=.env.development \
#     scripts/mint-storefront-token.mjs --channel=hayb-store --commit
WB_STOREFRONT_TOKEN=wb_pk_replace_me

# Never sent — the API resolves the channel from the token, by design.
# Used only by this suite's own assertions.
WB_CHANNEL_KEY=hayb-store
