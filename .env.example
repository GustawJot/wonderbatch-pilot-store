# Copy to .env and fill in. The real .env is gitignored — it holds a live token.

# The Wonderbatch API we call. Run it with `npm run dev` on port 3000;
# `npm run preview` cannot be used: it stamps a wildcard allow-origin header
# and, running in production mode, connects to the PRODUCTION database. `vite dev` adds a permissive allow-origin header to responses
# that lack one, which costs us exactly one assertion — the unregistered-origin
# preflight, which is skipped locally and runs against a deployed base URL.
WB_API_BASE_URL=http://localhost:3000

# What this client claims to be. MUST be sent on every request: a caller that
# omits the Origin header skips the channel's allowlist entirely and gets a
# 200, so a suite that forgets it never exercises the check at all.
# Must exactly match an entry in the channel's `security.allowed_origins`
# (exact string comparison — a trailing slash never matches).
WB_PILOT_ORIGIN=http://localhost:5173

# Mint with, from web/:
#   node --experimental-strip-types --env-file=.env.development \
#     scripts/mint-storefront-token.mjs --channel=hayb-store --commit
WB_STOREFRONT_TOKEN=wb_pk_replace_me

# Never sent — the API resolves the channel from the token, by design.
# Used only by this suite's own assertions.
WB_CHANNEL_KEY=hayb-store

# OPTIONAL. Only needed against dev./preview.wonderbatch.coffee, which sit
# behind Vercel SSO and 302 an unauthenticated request to vercel.com/sso-api
# before the app ever sees it. Get it from:
#   Vercel → wonderbatch → Settings → Deployment Protection
#            → Protection Bypass for Automation
# Consumed at Vercel's edge, not by the app — it is not an API credential.
# Leave unset for localhost.
# WB_VERCEL_BYPASS=
